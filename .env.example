# Get your API key from a free account at https://developers.ollang.com.
# Put the real key only in the ignored .env, never in this example file or chat.
# Bundled playback, recording/editing and local detection need no key.
OLLANG_API_KEY=
# The app binds this Docker host port only on 127.0.0.1.
APP_PORT=4310
# With a key enabled, Save automatically translates into supported non-source languages.
# Saved automatic requests can start/resume when a key is added. Translation uses credits.
